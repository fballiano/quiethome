<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.fballiano.quiethome">

    <!-- Holding OK on an app closes it (ends its background processes). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Only when granted over ADB (pm grant): QuietHome then turns its own service back on. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Only for Settings → Update QuietHome: read the latest release on GitHub and download it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Give the downloaded update to Android's installer, which asks the user to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ only shows a home screen the apps it asks for: TV apps, phone apps and other launchers. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.QuietHome">

        <activity
            android:name=".Home"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Configuration from a computer over ADB (adb shell am broadcast). DUMP keeps other apps out. -->
        <receiver
            android:name=".Config"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- The result of an update from Settings: the installer's confirmation, or a failure. -->
        <receiver
            android:name=".UpdateStatus"
            android:exported="false" />

        <!-- Optional remote buttons and Home button; off until turned on in Accessibility. -->
        <service
            android:name=".RemoteButtons"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_buttons" />
        </service>
    </application>
</manifest>
